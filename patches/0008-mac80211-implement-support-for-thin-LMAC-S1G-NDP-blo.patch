 {
 	struct ieee80211_local *local = sdata->local;
@@ -472,7 +472,7 @@ void ieee80211_send_delba(struct ieee80211_sub_if_data *sdata,
 	skb_put(skb, 1 + sizeof(mgmt->u.action.u.delba));
 
